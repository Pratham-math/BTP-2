# Optional cloud provider; not needed for Ollama/Piper text-based lessons.
GEMINI_API_KEY=put_your_key_here
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE=Kore
DATA_DIR=./data
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-q4_K_M
PIPER_VOICE=en_US-lessac-medium
PIPER_VOICES_DIR=./.local/voices
# cpu (default) or cuda (strict GPU requirement). See LOCAL_GPU_SETUP.md.
PIPER_DEVICE=cpu
JOB_TIMEOUT_SECONDS=3600
MIN_FREE_DISK_MB=512
MAX_JOB_DISK_MB=2048
# Set OLLAMA_NO_CLOUD=1 in the Ollama service environment, then restart Ollama.
# Only for an exclusively owned Ollama runtime: OLLAMA_EXCLUSIVE=1
# For a supervised WiFi demo, explicitly add its host/origin here.
# APP_HOSTS=127.0.0.1,localhost,::1
# APP_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173

# Complete teaching platform (server.platform:app); host-managed secrets only.
# PostgreSQL uses the dedicated backend role created by the setup procedure.
DATABASE_URL=
# Download the public CA from your Supabase Database Settings SSL panel.
DATABASE_SSL_ROOT_CERT=./.local/supabase-ca.crt
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Host-only Auth administration for requested account erasure. Never expose to
# the browser or parser container. Leave unset until an operator configures it.
SUPABASE_AUTH_ADMIN_KEY=
# Only after Google provider setup and a real-account login test.
GOOGLE_OAUTH_VERIFIED=false
PLATFORM_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000,http://localhost:8000
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
JUDGE0_URL=
JUDGE0_TOKEN=
JUDGE0_PYTHON_LANGUAGE_ID=
# Set true ONLY after the actual runner passes isolation tests.
JUDGE0_ISOLATION_VERIFIED=false
# Trusted, laptop-only demo exception. Requires PLATFORM_PROFILE=local.
# Executes Python on this machine without a security sandbox; never for untrusted code.
PLATFORM_LOCAL_DEMO_PYTHON=false
# Choose a route explicitly; current defaults below select cloud providers.
# Local text/narration: PLATFORM_TEXT_PROVIDER=ollama,
# PLATFORM_SPEECH_PROVIDER=piper. Install the runtime/model/voice separately.
# OLLAMA_MODEL above does not select platform author/verifier models.
# Pin these after benchmarking; an empty model setting disables generation.
PLATFORM_TEXT_PROVIDER=gemini
PLATFORM_TEXT_MODEL=
# Optional Gemini model for image/YouTube extraction; defaults to the Gemini text model.
# Set explicitly when using Ollama for text. This does not change the text provider.
PLATFORM_VISION_MODEL=
PLATFORM_VERIFIER_MODEL=
PLATFORM_SPEECH_PROVIDER=gemini
# Metadata-style Interactions TTS; select a supported model after testing.
PLATFORM_SPEECH_MODEL=
DAILY_MODEL_CALL_LIMIT=200
MAX_JOBS_PER_USER=3
MAX_QUEUED_JOBS=30
# Enable after measuring the quality, cost and usefulness of one-step lookahead.
PLATFORM_SPECULATION_ENABLED=false
# Run parsers only in the no-network container after host-level verification.
DOCUMENT_SANDBOX_VERIFIED=false
DOCUMENT_PARSER_IMAGE=btp2-parser:local
# Release flags: enable each only after its extraction acceptance cases pass.
PLATFORM_ENABLE_TOPIC_SOURCES=false
PLATFORM_ENABLE_DOCUMENT_SOURCES=false
PLATFORM_ENABLE_VISION_SOURCES=false
PLATFORM_ENABLE_YOUTUBE_SOURCES=false
# 64 hex characters, kept separately from encrypted backups. Never in frontend.
BTP_BACKUP_KEY=
